<?xml version="1.0" ?>
<!--
  Step 3: RS-Bpearl-like 3D LiDAR + thermal camera, Gazebo Fortress (ignition-gazebo6). NOT YET RUN.
  RS-Bpearl (RoboSense user manual): 32 channels, vertical FOV 90 deg (channel angles 2.3125..89.5 deg above the
  sensor's own horizontal plane, i.e. a dome around the sensor z axis), 360 deg horizontal, 0.2 deg azimuth at 10 Hz,
  range 0.1-30 m.  Approximations here: evenly spaced vertical angles (the real ones are unevenly spaced) and 0.4 deg
  azimuth (900 samples) to keep the simulation light; use 1800 for the real 0.2 deg.
  Mounting: the dome axis points forward (+x of the rig), so the sensor sees the half-space in front of the robot.
  Frame check: the LiDAR is posed with pitch 90 deg in the rig, so fusion_node needs the lidar-rpy option set to 0 1.5708 0.
  Scene: person_a, person_b (309 K), warm_box (308 K, body temperature but not human-shaped and only 0.5 m tall),
  heater (330 K), box_cold (ambient).
-->
<sdf version="1.6">
  <world name="bpearl_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ambient air temperature (K); small gradient so the scene is not perfectly uniform -->
    <atmosphere type="adiabatic">
      <temperature>293</temperature>
      <temperature_gradient>0.05</temperature_gradient>
    </atmosphere>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>30 30 0.1</size></box></geometry></collision>
        <visual name="visual">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>30 30 0.1</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Warm people (simplified as cylinders) -->
    <model name="person_a">
      <static>true</static>
      <pose>3 0.6 0.85 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.22</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.9 0.6 0.4 1</ambient><diffuse>0.9 0.6 0.4 1</diffuse></material>
          <plugin filename="ignition-gazebo-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>309.0</temperature>
          </plugin>
        </visual>
      </link>
    </model>

    <model name="person_b">
      <static>true</static>
      <pose>5.5 -2.2 0.85 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.22</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.9 0.6 0.4 1</ambient><diffuse>0.9 0.6 0.4 1</diffuse></material>
          <plugin filename="ignition-gazebo-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>309.0</temperature>
          </plugin>
        </visual>
      </link>
    </model>

    <!-- Cold box: same size as a person-ish obstacle, ambient temperature -->
    <model name="box_cold">
      <static>true</static>
      <pose>3.5 -0.8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 1</size></box></geometry>
          <material><ambient>0.3 0.3 0.8 1</ambient><diffuse>0.3 0.3 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

        <!-- Body-temperature object that is NOT a human: low, box-shaped. Thermal alone calls it human-like. -->
    <model name="warm_box">
      <static>true</static>
      <pose>2.4 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.5</size></box></geometry>
          <material><ambient>0.9 0.7 0.2 1</ambient><diffuse>0.9 0.7 0.2 1</diffuse></material>
          <plugin filename="ignition-gazebo-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>308.0</temperature>
          </plugin>
        </visual>
      </link>
    </model>

    <!-- Hot non-human object: a thermal false positive -->
    <model name="heater">
      <static>true</static>
      <pose>4 1.6 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.8</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
          <plugin filename="ignition-gazebo-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>330.0</temperature>
          </plugin>
        </visual>
      </link>
    </model>

    <!-- Sensor rig: 3D LiDAR + thermal camera, same link, same pose, looking along +x -->
    <model name="sensor_rig">
      <static>true</static>
      <pose>0 0 0.6 0 0 0</pose>
      <link name="rig_link">
        <collision name="collision"><geometry><box><size>0.15 0.15 0.15</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.15</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>

        <sensor name="bpearl" type="gpu_lidar">
          <pose>0 0 0 0 1.5707963 0</pose>
          <topic>bpearl</topic>
          <update_rate>10</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>900</samples>
                <resolution>1</resolution>
                <min_angle>-3.1415926</min_angle>
                <max_angle>3.1415926</max_angle>
              </horizontal>
              <vertical>
                <samples>32</samples>
                <resolution>1</resolution>
                <min_angle>0.040361</min_angle>
                <max_angle>1.562070</max_angle>
              </vertical>
            </scan>
            <range><min>0.1</min><max>30.0</max><resolution>0.01</resolution></range>
          </lidar>
          <always_on>1</always_on>
          <visualize>false</visualize>
        </sensor>

        <sensor name="thermal_camera" type="thermal">
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>320</width><height>240</height><format>L16</format></image>
            <clip><near>0.1</near><far>50</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <topic>thermal_camera</topic>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
